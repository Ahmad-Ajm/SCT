# v1.10-D1 (L-2): قالب آمن لمتغيّرات البيئة. انسخه إلى .env وعدّله:
#   cp .env.example .env
# .env مذكور في .gitignore — لن يُرفع للمستودع.

# ───── مفاتيح الـintegrations (كلّها اختياريّة، مطفأة افتراضياً) ─────

# PageSpeed Insights API — احصل على المفتاح من Google Cloud Console
# https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Backlinks (Ahrefs v3 أو Majestic OpenApp) — مدفوع
# اختر المزوّد في config.yaml ⇒ integrations.backlinks.provider
BACKLINKS_API_KEY=

# AI Advisor — يدعم OpenAI/Anthropic/DeepSeek/OpenRouter/Local-Compatible.
# المفتاح + base_url + الاسم النموذجي يُضبَطون في config.yaml ⇒ integrations.ai.*
AI_API_KEY=

# ───── حماية ─────

# SCT_NO_AUTO_INSTALL=1 يمنع auto-install للمتطلّبات الاختيارية أثناء التشغيل.
# مفيد للبيئات المقفولة أو لو أردت تثبيتاً يدوياً محكماً.
# SCT_NO_AUTO_INSTALL=1
