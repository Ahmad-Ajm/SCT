# v1.10-D1 (L-2): safe template for environment variables. Copy it to .env and edit:
#   cp .env.example .env
# .env is listed in .gitignore — it will not be pushed to the repository.

# ───── Integration keys (all optional, off by default) ─────

# PageSpeed Insights API — get the key from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Backlinks (Ahrefs v3 or Majestic OpenApp) — paid
# Choose the provider in config.yaml ⇒ integrations.backlinks.provider
BACKLINKS_API_KEY=

# AI Advisor — supports OpenAI/Anthropic/DeepSeek/OpenRouter/Local-Compatible.
# The key + base_url + model name are set in config.yaml ⇒ integrations.ai.*
AI_API_KEY=

# ───── Security ─────

# SCT_NO_AUTO_INSTALL=1 prevents auto-install of optional requirements at runtime.
# Useful for locked-down environments or if you want tight manual installation.
# SCT_NO_AUTO_INSTALL=1
